# Agent Passport UI env config. Copy to .env and fill real values.

# Contract addresses deployed by script/Deploy.s.sol on Sepolia.
VITE_AGENT_REGISTRAR=0xF160c7156CE7d4168b92daa9C72d1BBd64d82b2C
VITE_AGENT_REPUTATION=0x8e85bb15D7cFAD1879F4A2D275c50528f9aBb6dB
VITE_HUMAN_VERIFICATION=0x88C0a242Ab3d40b29a375393D873db200D21cB11

# Chain / subgraph / backend.
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_SUBGRAPH_URL=http://127.0.0.1:8001/subgraphs/name/agent-passport
VITE_BACKEND_URL=http://localhost:8787
VITE_ROOT_NAME=agentpassport.eth

# World ID app (also used in backend/.env).
VITE_WORLD_APP_ID=app_xxxxxxxxxxxx
VITE_WORLD_ACTION=verify-agent-passport-01
# "production" runs real World App selfie checks; "sandbox" opens the World ID
# Sandbox app (fake identity, official sandbox access); "staging" uses the World
# ID web Simulator (simulator.worldcoin.org). Env must match the proof you mint.
VITE_WORLD_ENV=production